APP_NAME="Globiim API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

# Supabase Auth identity verification for the React frontend
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_ORIGIN
APP_LOCALE=en
APP_FAKER_LOCALE=en_KE

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=globiim
DB_USERNAME=globiim_user
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="Globiim"

SANCTUM_STATEFUL_DOMAINS=
